---
import Ext from './Ext.astro';
// Landing-page frame: hero text, the three doors, the two-speed rule, the verification line.
// One screen at desktop; the footer override below carries the independence line.
import Door from './Door.astro';
import TwoSpeed from './TwoSpeed.astro';
import { FACTS_VERIFIED, formatDate, LINKS } from '../data/site';
---

<div class="rb-landing not-content">
  <section class="rb-landing__hero" aria-labelledby="_top">
    <p class="rb-eyebrow">Redbelly Network · chain 151 mainnet · chain 153 testnet</p>
    <h1 id="_top">Build on Redbelly Network with your own tools and your own agent.</h1>
    <p class="rb-landing__lede">
      A builder path from an idea to a dApp that is deployed, identity gated and checked before it reaches mainnet.
    </p>
    <ul class="rb-landing__who">
      <li>You write Solidity by hand. Take the golden path.</li>
      <li>You direct an AI coding agent. Start with the rules files.</li>
      <li>You already ship on Ethereum. The concept pages carry only what differs on this network.</li>
      <li>You review before mainnet. Start at the gate.</li>
    </ul>
  </section>

  <section class="rb-landing__doors" aria-label="Three ways in">
    <Door href="/start/" eyebrow="Start" title="Your first gated contract on testnet" text="Verify a wallet, get testnet RBNT, compile for Prague, deploy, gate one function. One path, followed start to finish." />
    <Door href="/agents/" eyebrow="Build with an agent" title="Rules files, llms.txt, and the key-handling rule" text="Drop one file into your project and your agent stops inventing chain IDs. Claude Code, Codex, Cursor, Copilot, Gemini." />
    <Door href="/review/" eyebrow="Review before mainnet" title="What the gate checks, and why" text="Pre-flight, the five credential states, admin behind a Safe, the ship report. The threat model here is not the one you carry over from Ethereum." />
  </section>

  <section class="rb-landing__speed" aria-labelledby="two-speeds">
    <h2 id="two-speeds" class="rb-heading">Two speeds, stated openly</h2>
    <p>
      An AI agent collapses the time it takes to build a working testnet dApp. It does not collapse the time it takes to build a safe mainnet one, and this network exists for assets with real value and real regulators behind them. The path therefore has two speeds, and the tooling enforces the second.
    </p>
    <TwoSpeed />
  </section>

  <section class="rb-landing__verified" aria-label="What is verified">
    <p>
      I checked every network fact here against Vine, docs.redbelly.network or the RPC on {formatDate(FACTS_VERIFIED)}, and each one is logged with its source in <Ext href={LINKS.research}>SOURCES.md</Ext>. This site does not claim a testnet run that did not happen. A step I have not executed says so.
    </p>
  </section>
</div>

<style>
  .rb-landing { display: flex; flex-direction: column; gap: 3rem; padding-block: 1rem 2rem; }
  @media (min-width: 50em) { .rb-landing { gap: 4rem; padding-block: 2rem 2rem; } }
  .rb-landing__hero { max-width: 48rem; }
  .rb-landing__hero h1 {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-4xl);
    font-weight: var(--rb-weight-heading);
    line-height: 1.1;
    letter-spacing: var(--rb-tracking-tight);
    color: var(--rb-color-heading);
  }
  @media (min-width: 50em) { .rb-landing__hero h1 { font-size: var(--sl-text-6xl); } }
  .rb-landing__lede { margin: 1.25rem 0 0; font-size: var(--sl-text-lg); line-height: 1.5; color: var(--rb-color-text); }
  .rb-landing__who {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: var(--sl-text-base);
    color: var(--rb-color-text-muted);
  }
  .rb-landing__who li { padding-left: 1rem; position: relative; line-height: 1.5; }
  .rb-landing__who li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.375rem;
    height: 1px;
    background: var(--rb-color-accent);
  }
  .rb-landing__doors { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .rb-landing__speed { padding: 1.5rem; border-radius: var(--rb-radius-xl); background: var(--rb-color-surface); }
  @media (min-width: 50em) { .rb-landing__speed { padding: 2rem 2.5rem; } }
  .rb-landing__speed h2 { margin: 0; font-size: var(--sl-text-2xl); }
  .rb-landing__speed p { margin: 0.75rem 0 0; max-width: 48rem; line-height: 1.6; }
  .rb-landing__verified p { margin: 0; font-size: var(--sl-text-sm); color: var(--rb-color-text-muted); max-width: 48rem; line-height: 1.6; }
  .rb-landing__verified a { color: var(--rb-color-accent); }
</style>
