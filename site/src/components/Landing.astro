---
// Landing-page frame: hero text, the three doors, the two-speed rule, the evidence block.
// The doors are three people, not three stages (PLAN.md 20.8): new to the network, looking for
// something to build, shipping for real or with a team. Nothing here sorts a reader by skill.
// One screen at desktop; the footer override below carries the independence line.
import Door from './Door.astro';
import TwoSpeed from './TwoSpeed.astro';
import Evidence from './Evidence.astro';
import { cards } from '../data/cards';

// Counted from the cards, never typed: a project counts as proven when it has a run record.
const projectCount = cards.length;
const provenCount = cards.filter((c) => c.run).length;
const onScaffoldCount = cards.filter((c) => c.scope === 'scaffold').length;
const toBuildCount = projectCount - onScaffoldCount;
const liveCount = cards.filter((c) => c.deployed).length;
const useRunCount = cards.filter((c) => c.deployed?.useRun).length;

// Door two says these numbers in words, and the words are the owner's to edit in her text files,
// so they are plain text below and not computed. This guard is what keeps them true: when the
// cards change, the build stops here until the door's sentence and these four numbers are updated
// together.
const DOOR_TWO_SAYS = { projects: 18, onScaffold: 7, toBuild: 11, proven: 18, live: 5, useRun: 4 };
const doorTwoIs = { projects: projectCount, onScaffold: onScaffoldCount, toBuild: toBuildCount, proven: provenCount, live: liveCount, useRun: useRunCount };
for (const key of Object.keys(DOOR_TWO_SAYS) as (keyof typeof DOOR_TWO_SAYS)[]) {
  if (DOOR_TWO_SAYS[key] !== doorTwoIs[key]) {
    throw new Error(`front page, door two: the sentence says ${DOOR_TWO_SAYS[key]} ${key} and src/data/cards.ts now has ${doorTwoIs[key]}. Update the door's words and DOOR_TWO_SAYS in Landing.astro together.`);
  }
}
---

<div class="rb-landing not-content">
  <section class="rb-landing__hero" aria-labelledby="_top">
    <p class="rb-eyebrow">Redbelly Network · chain 151 mainnet · chain 153 testnet</p>
    <h1 id="_top">Build on Redbelly Network the: your tools, your agent, your keys.</h1>
    <p class="rb-landing__lede">
      A path from an idea to a deployed dApp: identity-gated, checked, and only then mainnet.
    </p>
    <ul class="rb-landing__who">
      <li>If you write Solidity, take <a href="/start/">the golden path</a>.</li>
      <li>If you direct an AI coding agent, start with <a href="/agents/">the rules files</a>.</li>
    </ul>
  </section>

  <section class="rb-landing__doors" aria-label="Three ways in">
    <Door href="/concepts/" eyebrow="New to the network" title="What is different here, then your first gated contract" text="Four short pages on what changes for your code: finality, blocks on demand, gas priced in dollars, and the identity gate. Then one path from an empty folder to a gated contract, the same whether you write the Solidity or direct your own agent." />
    <Door href="/tutorials/" eyebrow="Looking for something to build" title="Eighteen projects that need what this network has" text="Seven that change the gated scaffold you already have, then eleven things to build that only make sense where every holder is verified: a tokenised bond, tickets with an age gate, a cap table, an ERC-3643 security token suite. All eighteen are proven from a fresh scaffold, with the record of the run beside them. Five are live on testnet, deployed and verified from my own wallet, and four of those have had their use run on the real network." />
    <Door href="/review/" eyebrow="Shipping for real, or with a team" title="What the gate checks before mainnet, and how to watch it after" text="Pre-flight, the five credential states, admin behind a Safe, the ship report a lead signs off, and alerts once the contract is live. The threat model here is not the one you carry over from Ethereum." />
  </section>

  <section class="rb-landing__speed" aria-labelledby="two-speeds">
    <h2 id="two-speeds" class="rb-heading">Fast to testnet, slow to mainnet</h2>
    <p>
      An AI agent makes a working testnet dApp quick to build. A safe mainnet one still takes as long as it ever did, and this network exists for assets with real value and real regulators behind them. So the path has two speeds, and the tooling enforces the slow one.
    </p>
    <TwoSpeed links={false} />
  </section>

  <Evidence />
</div>

<style>
  .rb-landing { display: flex; flex-direction: column; gap: 3rem; padding-block: 1rem 2rem; }
  @media (min-width: 50em) { .rb-landing { gap: 4rem; padding-block: 2rem 2rem; } }
  .rb-landing__hero { max-width: 48rem; }
  .rb-landing__hero h1 {
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-4xl);
    font-weight: var(--rb-weight-heading);
    line-height: 1.1;
    letter-spacing: var(--rb-tracking-tight);
    color: var(--rb-color-heading);
  }
  @media (min-width: 50em) { .rb-landing__hero h1 { font-size: var(--sl-text-6xl); } }
  .rb-landing__lede { margin: 1.25rem 0 0; font-size: var(--sl-text-lg); line-height: 1.5; color: var(--rb-color-text); }
  .rb-landing__who {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: var(--sl-text-base);
    color: var(--rb-color-text-muted);
  }
  .rb-landing__who li { padding-left: 1rem; position: relative; line-height: 1.5; }
  .rb-landing__who li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--rb-color-accent);
  }
  .rb-landing__who a { color: var(--rb-color-text); text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .rb-landing__who a:hover { color: var(--rb-color-accent-high); }
  .rb-landing__doors { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .rb-landing__speed { padding: 1.5rem; border-radius: var(--rb-radius-xl); background: var(--rb-color-surface); }
  @media (min-width: 50em) { .rb-landing__speed { padding: 2rem 2.5rem; } }
  .rb-landing__speed h2 { margin: 0; font-size: var(--sl-text-2xl); }
  .rb-landing__speed p { margin: 0.75rem 0 0; max-width: 48rem; line-height: 1.6; }
</style>
