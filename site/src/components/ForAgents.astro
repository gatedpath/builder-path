---
// The for-agents block: the page's facts in plain imperative form, at the top of every
// content page (PLAN section 12.1). Dark in both themes on purpose; it should read like a
// terminal. A <p> label rather than a heading keeps it out of the page outline above the h1.
import CopyButton from './CopyButton.astro';
interface Props { page: string; facts: string[]; block?: string }
const { page, facts, block } = Astro.props;
const id = 'for-agents-md';
const markdown =
  `## For agents: ${page}\n\n` +
  facts.map((f) => `- ${f}`).join('\n') +
  (block ? `\n\n\`\`\`\n${block.trim()}\n\`\`\`\n` : '\n');
---

<section class="rb-agents not-content" id="for-agents" aria-labelledby="for-agents-label">
  <div class="rb-agents__head">
    <p class="rb-agents__label" id="for-agents-label">For agents</p>
    <CopyButton target={id} label="Copy as markdown: the for-agents block" short="Copy as markdown" dark />
  </div>
  <ul class="rb-agents__facts">
    {facts.map((f) => <li>{f}</li>)}
  </ul>
  {block && <pre class="rb-agents__pre" tabindex="0"><code>{block.trim()}</code></pre>}
  <template id={id}>{markdown}</template>
</section>

<style>
  .rb-agents {
    margin-block: 1.25rem 1.75rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--rb-radius-lg);
    border-inline-start: 4px solid var(--rb-color-slate);
    background: var(--rb-color-agents-bg);
    color: var(--rb-color-agents-text);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .rb-agents__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .rb-agents__label {
    margin: 0;
    font-size: var(--sl-text-2xs);
    font-weight: 600;
    letter-spacing: var(--rb-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--rb-color-agents-label);
  }
  .rb-agents__facts { margin: 0.75rem 0 0; padding-inline-start: 1.25rem; }
  .rb-agents__facts li { overflow-wrap: anywhere; }
  .rb-agents__facts li + li { margin-top: 0.375rem; }
  .rb-agents__facts a { color: var(--rb-color-agents-label); }
  .rb-agents__pre {
    margin: 1rem 0 0;
    padding: 0.875rem 1rem;
    border-radius: var(--rb-radius-md);
    background: #0C1A24;
    border: 1px solid #283A46;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: #EFF3F6;
  }
  :root[data-theme='light'] .rb-agents__pre { background: #0C1A24; }
  .rb-agents__pre code { font-family: inherit; }
</style>
