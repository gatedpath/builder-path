---
// The prompt card grid with client-side filtering by what you will build, by recipe, and by
// whether the card has been run. Chips are real buttons with aria-pressed; with no JavaScript
// every card shows. A live region announces the count. The grid is a list, one card per item.
// Filtering by difficulty was removed on 22 September 2026: a reader is never sorted by rank
// (PLAN 20.8). "Proven" is not a rating either, it is whether a run record exists.
import PromptCard from './PromptCard.astro';
import { scopeLabels, recipeLabels, type Scope, type PromptCardData, type Recipe } from '../data/cards';
interface Props { cards: PromptCardData[]; filters?: boolean; id?: string }
const { cards, filters = true, id = 'card-grid' } = Astro.props;
const scopes = (Object.keys(scopeLabels) as Scope[]).filter((v) => cards.some((c) => c.scope === v));
const recipes = (Object.keys(recipeLabels) as Recipe[]).filter((r) => cards.some((c) => c.recipes.includes(r)));
const provenCount = cards.filter((c) => c.run).length;
const liveCount = cards.filter((c) => c.deployed).length;
---

<div class="rb-grid not-content" id={id} data-rb-grid>
  {
    filters && (
      <div class="rb-grid__filters">
        <div class="rb-grid__group" role="group" aria-label="Filter by what you will build">
          <span class="rb-eyebrow">You build</span>
          {scopes.map((v) => (
            <button type="button" class="rb-grid__chip" data-filter="scope" data-value={v} aria-pressed="false">{scopeLabels[v]}</button>
          ))}
        </div>
        <div class="rb-grid__group" role="group" aria-label="Filter by recipe">
          <span class="rb-eyebrow">Recipe</span>
          {recipes.map((r) => (
            <button type="button" class="rb-grid__chip" data-filter="recipe" data-value={r} aria-pressed="false">{recipeLabels[r]}</button>
          ))}
        </div>
        {provenCount > 0 && provenCount < cards.length && (
          <div class="rb-grid__group" role="group" aria-label="Filter by whether the card has been run">
            <span class="rb-eyebrow">Run</span>
            <button type="button" class="rb-grid__chip" data-filter="proven" data-value="yes" aria-pressed="false">
              Run from a fresh scaffold ({provenCount})
            </button>
          </div>
        )}
        {liveCount > 0 && liveCount < cards.length && (
          <div class="rb-grid__group" role="group" aria-label="Filter by whether the card has been run">
            <span class="rb-eyebrow">Run</span>
            <button type="button" class="rb-grid__chip" data-filter="live" data-value="yes" aria-pressed="false">
              Live on testnet ({liveCount})
            </button>
          </div>
        )}
        <p class="rb-grid__count" aria-live="polite" data-count>Showing all {cards.length} cards.</p>
      </div>
    )
  }
  <ul class="rb-grid__list">
    {cards.map((card) => <PromptCard card={card} />)}
  </ul>
  {filters && <p class="rb-grid__empty" data-empty hidden>No card matches those filters. <button type="button" class="rb-grid__clear" data-clear>Clear filters</button></p>}
</div>

<script>
  for (const grid of document.querySelectorAll<HTMLElement>('[data-rb-grid]')) {
    const chips = [...grid.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...grid.querySelectorAll<HTMLElement>('.rb-pcard')];
    const count = grid.querySelector<HTMLElement>('[data-count]');
    const empty = grid.querySelector<HTMLElement>('[data-empty]');
    if (!chips.length) continue;
    const apply = () => {
      const on = (kind: string) => chips.filter((c) => c.dataset.filter === kind && c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.value);
      const scopes = on('scope');
      const recipes = on('recipe');
      const provenOnly = on('proven').length > 0;
      const liveOnly = on('live').length > 0;
      let shown = 0;
      for (const card of cards) {
        const okScope = !scopes.length || scopes.includes(card.dataset.scope ?? '');
        const mine = (card.dataset.recipes ?? '').split(' ');
        const okRecipe = !recipes.length || recipes.some((r) => mine.includes(r ?? ''));
        const okProven = !provenOnly || card.dataset.proven !== undefined;
        const okLive = !liveOnly || card.dataset.live !== undefined;
        const show = okScope && okRecipe && okProven && okLive;
        card.hidden = !show;
        if (show) shown++;
      }
      if (count) count.textContent = shown === cards.length ? `Showing all ${cards.length} cards.` : `Showing ${shown} of ${cards.length} cards.`;
      if (empty) empty.hidden = shown > 0;
    };
    for (const chip of chips) chip.addEventListener('click', () => { chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true'); apply(); });
    grid.querySelector('[data-clear]')?.addEventListener('click', () => { chips.forEach((c) => c.setAttribute('aria-pressed', 'false')); apply(); });
  }
</script>

<style>
  .rb-grid { margin-block: 1.25rem; }
  .rb-grid__filters { display: flex; flex-direction: column; gap: 0.625rem; margin-bottom: 1rem; }
  .rb-grid__group { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .rb-grid__group .rb-eyebrow { min-width: 4.75rem; }
  .rb-grid__chip {
    min-height: 2rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--rb-radius-md);
    border: 1px solid var(--rb-color-hairline-strong);
    background: var(--rb-color-bg);
    color: var(--rb-color-text);
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: background-color var(--rb-duration-fast) var(--rb-ease-standard), color var(--rb-duration-fast) var(--rb-ease-standard), border-color var(--rb-duration-base) var(--rb-ease-standard);
  }
  .rb-grid__chip:hover { border-color: var(--rb-color-accent); color: var(--rb-color-accent-high); }
  .rb-grid__chip[aria-pressed='true'] { background: var(--rb-color-accent-low); color: var(--rb-color-accent-high); border-color: var(--rb-color-accent); font-weight: 600; }
  @media (pointer: coarse) { .rb-grid__chip { min-height: var(--rb-target-min); } }
  .rb-grid__count { margin: 0; font-size: var(--sl-text-sm); color: var(--rb-color-text-muted); }
  .rb-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .rb-grid__empty { margin: 1rem 0 0; font-size: var(--sl-text-sm); }
  .rb-grid__clear { background: none; border: 0; padding: 0.5rem 0; color: var(--rb-color-accent); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
</style>
