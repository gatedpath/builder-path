---
// A link that may leave the site. An external link opens in a new tab, because Vine, Routescan and
// GitHub have no way back to us and a reader is usually mid-task when they follow one; it says so
// to a screen reader, and site.css draws the arrow. An internal link is rendered untouched.
// The same rule is applied to links inside page text by rehypeExternalLinks in astro.config.mjs.
interface Props { href: string; class?: string }
const { href, class: className } = Astro.props;
const external = /^https?:\/\//.test(href);
---
{external
  ? <a href={href} class={className} target="_blank" rel="noopener"><slot /><span class="sr-only"> (opens in a new tab)</span></a>
  : <a href={href} class={className}><slot /></a>}
