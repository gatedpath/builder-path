{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist/esm",
    "rootDir": "src",
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["src"]
}
